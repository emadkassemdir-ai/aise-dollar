{
  "name": "aise-dollar",
  "version": "3.0.0",
  "description": "AISE Dollar — the school currency of the American International School in Egypt (1 AISE$ = 10 EGP).",
  "private": true,
  "license": "MIT",
  "type": "commonjs",
  "scripts": {
    "test": "node --test tests/money.test.js && npm run test:rules",
    "test:rules": "firebase emulators:exec --only firestore --project demo-aise \"node --test tests/rules.test.mjs\"",
    "dev": "firebase emulators:exec --only auth,firestore --project demo-aise \"npx --yes http-server -p 5000 -c-1 .\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "firebase": "10.14.1",
    "firebase-tools": "^13.35.1"
  }
}
